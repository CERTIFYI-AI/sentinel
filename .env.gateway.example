# Sentinel enforcement GATEWAY — environment template.
# Copy to `.env` on the host and fill in. Never commit the real .env.
#   cp .env.gateway.example .env
#
# The app reads these via pydantic-settings (env_prefix SENTINEL_, plus the
# provider keys litellm reads directly). See docs/operations/gateway-deployment.md.

# --- Required: app ---------------------------------------------------------
# JWT signing secret, >= 32 chars. Generate: openssl rand -hex 32
SENTINEL_SECRET_KEY=

# Service-role Postgres DSN for the Supabase project (Database → Connection
# pooling). The gateway resolves tenants and writes the audit chain here.
SENTINEL_DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres

# --- Required: Redis (rate limiting) ---------------------------------------
# Password for the bundled redis service, and the URL the app connects with.
# Keep the two in sync. Without Redis the app falls back to in-memory limits,
# which do not survive a restart — set it for real enforcement.
REDIS_PASSWORD=
SENTINEL_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- Required: LLM provider keys (read by litellm directly) -----------------
# Set the keys for whichever providers your tenants route to. litellm picks
# these up from the standard variable names.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional: environment label -------------------------------------------
SENTINEL_ENVIRONMENT=production

# --- Ingress: Cloudflare Tunnel (only for `--profile tunnel`) ---------------
# Token from Cloudflare Zero Trust → Networks → Tunnels. With this, the VM
# needs no open inbound ports and no TLS certificate of its own.
CLOUDFLARE_TUNNEL_TOKEN=
