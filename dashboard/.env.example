# Sentinel Dashboard Environment Configuration
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_URL=http://localhost:8000/api

# App Configuration
VITE_APP_NAME=Certifyi Sentinel
VITE_APP_VERSION=0.4.0

# Feature Flags
VITE_ENABLE_AUTH=true
VITE_ENABLE_MOCK_DATA=true

# Supabase Configuration (optional — enables cloud persistence)
VITE_SUPABASE_URL=https://vhparvughsygyknblkzt.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry / Error Tracking (optional)
# VITE_SENTRY_DSN=

# Analytics (optional)
# VITE_ANALYTICS_ID=
