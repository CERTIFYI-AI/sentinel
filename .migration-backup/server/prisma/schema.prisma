generator client {
  provider = "prisma-client-js"
}

datasource db {
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  provider  = "postgresql"
}

model Tenant {
  id        String   @id
  name      String
  domain    String?
  settings  Json?    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users         User[]
  frameworks    Framework[]
  policies      Policy[]
  controls      Control[]
  models        Model[]
  datasets      Dataset[]
  agents        Agent[]
  vendors       Vendor[]
  biasAudits    BiasAudit[]
  evidence      Evidence[]
  hitlItems     HitlItem[]
  riskEntries   RiskEntry[]
  regulations   Regulation[]
  guardrailRules GuardrailRule[]
  trustTraces   TrustTrace[]
  auditLogs     AuditLog[]
}

model User {
  id           String   @id
  email        String   @unique
  name         String
  role         String
  department   String?
  passwordHash String
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownedPolicies Policy[] @relation("PolicyOwner")
  ownedModels   Model[]  @relation("ModelOwner")
  ownedRisks    RiskEntry[] @relation("RiskOwner")
}

model Framework {
  id          String   @id
  name        String
  version     String?
  description String?
  category    String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  policies    Policy[]
  controls    Control[]
}

model Policy {
  id           String    @id
  title        String
  status       String
  version      Int       @default(1)
  content      String?
  ownerId      String
  owner        User      @relation("PolicyOwner", fields: [ownerId], references: [id])
  frameworkId  String
  framework    Framework @relation(fields: [frameworkId], references: [id])
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  approvedAt   DateTime?
  deprecatedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  controls     Control[]
}

model Control {
  id          String    @id
  title       String
  status      String
  evidence    String?
  policyId    String
  policy      Policy    @relation(fields: [policyId], references: [id])
  frameworkId String
  framework   Framework @relation(fields: [frameworkId], references: [id])
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  evidenceItems Evidence[]
}

model Model {
  id            String    @id
  name          String
  type          String?
  status        String
  riskLevel     String?
  version       String?
  description   String?
  accuracy      Float?
  lastAuditDate DateTime?
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id])
  datasetId     String?
  dataset       Dataset?  @relation(fields: [datasetId], references: [id])
  ownerId       String
  owner         User      @relation("ModelOwner", fields: [ownerId], references: [id])
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  agents        Agent[]
  biasAudits    BiasAudit[]
  evidenceItems Evidence[]
  guardrailRules GuardrailRule[]
  trustTraces   TrustTrace[]
  riskEntries   RiskEntry[]
}

model Dataset {
  id                String   @id
  name              String
  source            String?
  recordCount       Int?
  hasPii            Boolean  @default(false)
  hasDemographicData Boolean @default(false)
  description       String?
  lastUpdated       DateTime?
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  createdAt         DateTime @default(now())
  models            Model[]
  biasAudits        BiasAudit[]
}

model Agent {
  id          String   @id
  name        String
  status      String
  source      String
  modelId     String?
  model       Model?   @relation(fields: [modelId], references: [id])
  department  String?
  description String?
  isShadowAi  Boolean @default(false)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model Vendor {
  id              String    @id
  name            String
  riskTier        Int?
  status          String
  contactEmail    String?
  contractExpiry  DateTime?
  lastAssessment  DateTime?
  suspendedReason String?
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  createdAt       DateTime  @default(now())
  models          Model[]
}

model BiasAudit {
  id          String    @id
  modelId     String
  model       Model     @relation(fields: [modelId], references: [id])
  datasetId   String
  dataset     Dataset   @relation(fields: [datasetId], references: [id])
  status      String
  startedAt   DateTime?
  completedAt DateTime?
  result      Json?
  triggeredBy String
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
}

model Evidence {
  id          String   @id
  controlId   String
  control     Control  @relation(fields: [controlId], references: [id])
  modelId     String?
  model       Model?   @relation(fields: [modelId], references: [id])
  type        String
  source      String
  title       String
  collectedAt DateTime?
  isStale     Boolean  @default(false)
  uploadedBy  String
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model HitlItem {
  id         String    @id
  entityType String
  entityId   String
  action     String
  status     String
  assignedTo String
  createdBy  String
  decidedAt  DateTime?
  decision   String?
  priority   String?
  dueDate    DateTime?
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  createdAt  DateTime  @default(now())
}

model RiskEntry {
  id         String   @id
  title      String
  likelihood Int
  impact     Int
  riskScore  Int
  category   String
  modelId    String?
  model      Model?   @relation(fields: [modelId], references: [id])
  mitigation String?
  status     String
  ownerId    String
  owner      User     @relation("RiskOwner", fields: [ownerId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Regulation {
  id            String   @id
  name          String
  jurisdiction  String?
  effectiveDate DateTime?
  category      String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model GuardrailRule {
  id        String   @id
  name      String
  type      String
  modelId   String?
  model     Model?   @relation(fields: [modelId], references: [id])
  rule      String
  action    String
  isActive  Boolean  @default(true)
  createdBy String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
}

model TrustTrace {
  id                  String   @id
  modelId             String
  model               Model    @relation(fields: [modelId], references: [id])
  trustScore          Float
  fairnessScore       Float?
  transparencyScore   Float?
  robustnessScore     Float?
  privacyScore        Float?
  accountabilityScore Float?
  timestamp           DateTime
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  createdAt           DateTime @default(now())
}

model AuditLog {
  id         String   @id
  entityType String
  entityId   String
  action     String
  userId     String
  details    Json?
  timestamp  DateTime
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
}
