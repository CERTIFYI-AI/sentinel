# ============================================================
# Sentinel AI GRC - Environment Configuration Example
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================
#
# This file configures the PYTHON BACKEND. The React dashboard has its own
# build-time contract in `dashboard/.env.example`:
#   VITE_SUPABASE_URL=https://vhparvughsygyknblkzt.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon public key>   # publishable; never the service_role key
# These are inlined by Vite at build time and gated by isSupabaseConfigured();
# when unset the dashboard runs in demo mode (queries return empty results).
# In CI they come from GitHub Actions: vars.VITE_SUPABASE_URL +
# secrets.VITE_SUPABASE_ANON_KEY (see .github/workflows/deploy-dashboard.yml).

# --- Application ---
APP_NAME=sentinel-ai-grc
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://sentinel_user:change-me-strong-password@localhost:5432/sentinel_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=change-me
SMTP_TLS=true
EMAILS_FROM=no-reply@certifyi.ai

# --- Storage (S3-compatible) ---
S3_BUCKET=sentinel-evidence
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_ENDPOINT_URL=

# --- AI / LLM ---
OPENAI_API_KEY=sk-change-me
ANTHROPIC_API_KEY=
SENTINEL_AI_MODEL=gpt-4o

# --- Monitoring ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_ENABLED=false

# --- Compliance ---
AUDIT_LOG_RETENTION_DAYS=2555
ENCRYPTION_KEY=change-me-32-byte-fernet-key
