# Certifyi Sentinel — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM Provider API Keys ──
# Primary model provider (OpenAI). Required for verification and cross-check.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Fallback model provider (Anthropic). Used for Level 2 circuit breaker upgrade.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Database ──
# PostgreSQL with pgvector extension for golden source embeddings and audit log.
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel

# ── Redis ──
# Used for circuit breaker state, rate limiting, and Celery task broker.
REDIS_URL=redis://localhost:6379/0

# ── Sentinel Configuration ──
# Path to sentinel.yaml configuration file.
SENTINEL_CONFIG_PATH=configs/sentinel.yaml

# Secret key for signing audit entries. Generate with: python scripts/generate_keys.py
SENTINEL_AUDIT_SIGNING_KEY=

# ── Authentication ──
# API key for authenticating requests to the Sentinel proxy.
# In production, use a proper auth provider (Auth0, Clerk, etc.)
SENTINEL_API_KEY=sentinel-dev-key-change-me

# ── Observability ──
# OpenTelemetry collector endpoint for distributed tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO